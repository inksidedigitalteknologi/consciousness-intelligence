# Inkside Digital - Environment Variables
# Copy file ini ke .env dan isi nilai sebenarnya.
# JANGAN commit .env ke git!

# === API ===
API_KEY=your_api_key_here
API_PORT=5000
API_HOST=0.0.0.0

# === MODE ===
INKSIDE_MODE=PAPER
DEBUG_MODE=false
LOG_LEVEL=INFO

# === DEEPSEEK AI ===
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# === TELEGRAM (opsional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === DATA SOURCES (opsional) ===
GOOGLE_SHEETS_API_KEY=
IDX_SHEET_ID=
