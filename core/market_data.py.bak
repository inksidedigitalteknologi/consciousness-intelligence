# core/market_data.py
# COINGECKO MARKET DATA - REAL EXCHANGE INTEGRATION
# 
# COGNITIVE MIRROR ENGINE v5.0 - ULTIMATE
# 
# Provides real-time and historical market data from CoinGecko API.
# Supports API Key for higher rate limits (50 requests/min with free API key).
# ============================================================

import os
import json
import logging
import time
import requests
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Any, Union
from dataclasses import dataclass, field
from enum import Enum

logger = logging.getLogger(__name__)

# ============================================================
# VERSION
# ============================================================

COINGECKO_VERSION = "1.0.0"

# ============================================================
# ENUMS
# ============================================================

class Interval(Enum):
    MINUTE_1 = "1m"
    MINUTE_5 = "5m"
    MINUTE_15 = "15m"
    MINUTE_30 = "30m"
    HOUR_1 = "1h"
    HOUR_4 = "4h"
    HOUR_12 = "12h"
    DAY_1 = "1d"
    WEEK_1 = "1w"


class DataSource(Enum):
    CACHE = "cache"
    API = "api"
    FALLBACK = "fallback"


# ============================================================
# DATA CLASSES
# ============================================================

@dataclass
class TickerData:
    pair: str
    price: float
    bid: float
    ask: float
    high_24h: float
    low_24h: float
    volume_24h: float
    change_24h: float
    timestamp: str = field(default_factory=lambda: datetime.now().isoformat())
    source: DataSource = DataSource.API
    is_mock: bool = False


@dataclass
class Candle:
    pair: str
    interval: str
    timestamp: datetime
    open: float
    high: float
    low: float
    close: float
    volume: float


@dataclass
class OrderBookLevel:
    price: float
    volume: float


@dataclass
class OrderBook:
    pair: str
    bids: List[OrderBookLevel]
    asks: List[OrderBookLevel]
    timestamp: str


@dataclass
class Trade:
    pair: str
    price: float
    volume: float
    side: str
    timestamp: datetime


# ============================================================
# COINGECKO CONFIG - DENGAN API KEY
# ============================================================
COINGECKO_API_BASE = os.getenv("COINGECKO_API_BASE", "https://api.coingecko.com/api/v3")
COINGECKO_API_KEY = os.getenv("COINGECKO_API_KEY", "")

# Rate Limiting
if COINGECKO_API_KEY:
    COINGECKO_RATE_LIMIT = 50       # 50 requests per minute (free tier with API key)
else:
    COINGECKO_RATE_LIMIT = 30       # 30 requests per minute (tanpa API key)

REQUEST_DELAY = 0.5                 # 0.5s = 120 request/menit (aman)
REQUEST_TIMEOUT = 15
REQUEST_RETRY_COUNT = 3
REQUEST_RETRY_DELAY = 2
REQUEST_BACKOFF_MULTIPLIER = 2

# Cache
CACHE_TTL_SECONDS = 120             # 2 menit cache

# Pair mapping: BTC/USD -> bitcoin
PAIR_TO_COINGECKO = {
    "BTC/USD": "bitcoin",
    "BTC/USDT": "bitcoin",
    "ETH/USD": "ethereum",
    "ETH/USDT": "ethereum",
    "SOL/USD": "solana",
    "SOL/USDT": "solana",
    "XRP/USD": "ripple",
    "XRP/USDT": "ripple",
    "ADA/USD": "cardano",
    "ADA/USDT": "cardano",
    "DOT/USD": "polkadot",
    "DOT/USDT": "polkadot",
    "LINK/USD": "chainlink",
    "LINK/USDT": "chainlink",
    "AVAX/USD": "avalanche-2",
    "AVAX/USDT": "avalanche-2",
    "MATIC/USD": "matic-network",
    "MATIC/USDT": "matic-network",
    "UNI/USD": "uniswap",
    "UNI/USDT": "uniswap",
    "LTC/USD": "litecoin",
    "LTC/USDT": "litecoin",
    "BNB/USD": "binancecoin",
    "BNB/USDT": "binancecoin",
}

# Reverse mapping
COINGECKO_TO_PAIR = {v: k for k, v in PAIR_TO_COINGECKO.items()}

# Supported pairs
SUPPORTED_PAIRS = list(PAIR_TO_COINGECKO.keys())


# ============================================================
# SAFE HTTP REQUEST - DENGAN API KEY
# ============================================================

def _call_coingecko_api(endpoint: str, params: Dict = None) -> Optional[Dict]:
    """Call CoinGecko API with API Key support."""
    url = f"{COINGECKO_API_BASE}/{endpoint}"
    
    # Headers dengan API Key
    headers = {
        "User-Agent": "InksideIntelligence/5.0"
    }
    if COINGECKO_API_KEY:
        headers["x-cg-pro-api-key"] = COINGECKO_API_KEY
    
    # Rate limiting
    time.sleep(REQUEST_DELAY)
    
    try:
        response = requests.get(url, params=params, headers=headers, timeout=REQUEST_TIMEOUT)
        
        if response.status_code == 200:
            return response.json()
        elif response.status_code == 429:
            logger.warning(f"CoinGecko rate limit exceeded (using API key: {bool(COINGECKO_API_KEY)}), waiting 5 seconds...")
            time.sleep(5)
            return _call_coingecko_api(endpoint, params)
        else:
            logger.warning(f"CoinGecko API error {response.status_code}: {response.text[:200]}")
            return None
            
    except requests.exceptions.Timeout:
        logger.warning("CoinGecko API timeout")
        return None
    except requests.exceptions.ConnectionError:
        logger.warning("CoinGecko API connection error")
        return None
    except Exception as e:
        logger.warning(f"CoinGecko API error: {e}")
        return None


# ============================================================
# COINGECKO MARKET DATA CLASS
# ============================================================

class CoinGeckoMarketData:
    """
    CoinGecko Market Data Integration.
    Supports API Key for higher rate limits.
    Free API key available at: https://www.coingecko.com/en/api
    """
    
    TIMEOUT = 15
    RETRIES = 3
    BACKOFF = 0.5
    CACHE_TTL = CACHE_TTL_SECONDS
    MAX_CACHE_SIZE = 100
    
    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
        self.api_base = COINGECKO_API_BASE
        self.api_key = COINGECKO_API_KEY
        
        self._cache: Dict[str, Dict] = {}
        self._cache_time: Dict[str, float] = {}
        self._last_request_time = 0
        self._request_count = 0
        self._is_online = False
        
        self.pairs = SUPPORTED_PAIRS
        
        # Log API Key status
        if self.api_key:
            logger.info(f"🔑 CoinGecko API Key configured (rate limit: 50/min)")
        else:
            logger.info("ℹ️  CoinGecko API Key not set (rate limit: 30/min)")
        
        # Test connection
        self._test_connection()
        
        logger.info(f"📊 CoinGecko Market Data v{COINGECKO_VERSION} initialized")
        logger.info(f"   API Base: {self.api_base}")
        logger.info(f"   Status: {'ONLINE' if self._is_online else 'OFFLINE'}")
        logger.info(f"   Pairs: {len(self.pairs)} configured")
    
    def _test_connection(self) -> bool:
        """Test API connection."""
        try:
            result = _call_coingecko_api('ping')
            if result and result.get('gecko_says') == '(V3) To the Moon!':
                self._is_online = True
                logger.info("✅ CoinGecko connection successful")
                return True
            else:
                self._is_online = False
                logger.warning("⚠️ CoinGecko connection failed")
                return False
        except Exception as e:
            self._is_online = False
            logger.warning(f"⚠️ CoinGecko connection error: {e}")
            return False
    
    def _should_cache(self, key: str) -> bool:
        if key not in self._cache_time:
            return False
        return (time.time() - self._cache_time[key]) < self.CACHE_TTL
    
    def _cache_get(self, key: str) -> Optional[Any]:
        if self._should_cache(key):
            return self._cache.get(key)
        return None
    
    def _cache_set(self, key: str, value: Any) -> None:
        if len(self._cache) > self.MAX_CACHE_SIZE:
            oldest = sorted(self._cache_time.items(), key=lambda x: x[1])[:10]
            for k, _ in oldest:
                self._cache.pop(k, None)
                self._cache_time.pop(k, None)
        self._cache[key] = value
        self._cache_time[key] = time.time()
    
    def _rate_limit(self) -> None:
        """Rate limit requests."""
        elapsed = time.time() - self._last_request_time
        if elapsed < REQUEST_DELAY:
            time.sleep(REQUEST_DELAY - elapsed)
        self._last_request_time = time.time()
        self._request_count += 1
    
    def get_ticker(self, pair: str) -> Optional[TickerData]:
        """Get ticker data for a pair."""
        cache_key = f"ticker_{pair}"
        cached = self._cache_get(cache_key)
        if cached:
            return cached
        
        coin_id = PAIR_TO_COINGECKO.get(pair)
        if not coin_id:
            logger.warning(f"Pair {pair} not supported by CoinGecko")
            return None
        
        try:
            self._rate_limit()
            result = _call_coingecko_api(
                f'simple/price',
                {
                    'ids': coin_id,
                    'vs_currencies': 'usd',
                    'include_24hr_vol': 'true',
                    'include_24hr_change': 'true',
                    'include_last_updated_at': 'true'
                }
            )
            
            if result and coin_id in result:
                data = result[coin_id]
                price = float(data.get('usd', 0))
                change_24h = float(data.get('usd_24h_change', 0))
                volume_24h = float(data.get('usd_24h_vol', 0))
                
                # Get 24h high/low from market_chart
                market_data = _call_coingecko_api(
                    f'coins/{coin_id}/market_chart',
                    {'vs_currency': 'usd', 'days': '1'}
                )
                
                high_24h = price * 1.05
                low_24h = price * 0.95
                
                if market_data and 'prices' in market_data:
                    prices = market_data['prices']
                    if prices:
                        high_24h = max(p[1] for p in prices)
                        low_24h = min(p[1] for p in prices)
                
                ticker_data = TickerData(
                    pair=pair,
                    price=price,
                    bid=price * 0.999,
                    ask=price * 1.001,
                    high_24h=high_24h,
                    low_24h=low_24h,
                    volume_24h=volume_24h,
                    change_24h=change_24h,
                    is_mock=False
                )
                self._cache_set(cache_key, ticker_data)
                return ticker_data
            
        except Exception as e:
            logger.debug(f"Ticker error for {pair}: {e}")
        
        # Return None if API fails (no fallback to mock)
        return None
    
    def get_latest_prices(self, pairs: Optional[List[str]] = None) -> Dict[str, float]:
        """Get latest prices for multiple pairs."""
        if pairs is None:
            pairs = self.pairs
        
        result = {}
        for pair in pairs:
            ticker = self.get_ticker(pair)
            if ticker:
                result[pair] = ticker.price
            else:
                result[pair] = 0.0
        
        return result
    
    def get_ohlc(
        self,
        pair: str,
        interval: Union[Interval, str] = Interval.HOUR_1,
        limit: int = 250
    ) -> List[Candle]:
        """Get OHLC candle data."""
        if isinstance(interval, Interval):
            interval = interval.value
        
        coin_id = PAIR_TO_COINGECKO.get(pair)
        if not coin_id:
            return []
        
        cache_key = f"ohlc_{coin_id}_{interval}_{limit}"
        cached = self._cache_get(cache_key)
        if cached:
            return cached
        
        try:
            self._rate_limit()
            
            # CoinGecko OHLC endpoint
            days = 1
            if interval == '1m':
                days = 1
            elif interval == '5m':
                days = 1
            elif interval == '15m':
                days = 2
            elif interval == '30m':
                days = 3
            elif interval == '1h':
                days = 7
            elif interval == '4h':
                days = 30
            elif interval == '1d':
                days = 90
            elif interval == '1w':
                days = 365
            
            result = _call_coingecko_api(
                f'coins/{coin_id}/ohlc',
                {
                    'vs_currency': 'usd',
                    'days': days
                }
            )
            
            if result and isinstance(result, list):
                candles = []
                for item in result[-limit:]:
                    if isinstance(item, list) and len(item) >= 4:
                        candles.append(Candle(
                            pair=pair,
                            interval=interval,
                            timestamp=datetime.fromtimestamp(int(item[0]) / 1000),
                            open=float(item[1]),
                            high=float(item[2]),
                            low=float(item[3]),
                            close=float(item[4]),
                            volume=0  # CoinGecko OHLC doesn't provide volume
                        ))
                
                if candles:
                    self._cache_set(cache_key, candles)
                    return candles
            
        except Exception as e:
            logger.debug(f"OHLC error for {pair}: {e}")
        
        return []
    
    def get_order_book(self, pair: str, depth: int = 10) -> Optional[OrderBook]:
        """Get order book data (mock for CoinGecko)."""
        ticker = self.get_ticker(pair)
        if not ticker:
            return None
        
        base_price = ticker.price
        bids = [OrderBookLevel(price=base_price - i * 10, volume=1.0 + i * 0.1) for i in range(depth)]
        asks = [OrderBookLevel(price=base_price + i * 10, volume=1.0 + i * 0.1) for i in range(depth)]
        return OrderBook(pair=pair, bids=bids, asks=asks, timestamp=datetime.now().isoformat())
    
    def get_trades(self, pair: str, limit: int = 50) -> List[Trade]:
        """Get recent trades (mock for CoinGecko)."""
        ticker = self.get_ticker(pair)
        if not ticker:
            return []
        
        base_price = ticker.price
        trades = []
        for i in range(limit):
            price = base_price * (1 + 0.001 * (i % 10 - 5))
            trades.append(Trade(
                pair=pair,
                price=price,
                volume=0.1 + i * 0.01,
                side="buy" if i % 2 == 0 else "sell",
                timestamp=datetime.now() - timedelta(seconds=i * 10)
            ))
        return trades
    
    def health_check(self) -> Dict[str, Any]:
        """Check exchange health."""
        try:
            if self._is_online:
                ticker = self.get_ticker("BTC/USD")
                return {
                    "status": "ONLINE",
                    "health_score": 100.0,
                    "version": COINGECKO_VERSION,
                    "last_check": datetime.now().isoformat(),
                    "price": ticker.price if ticker else 0,
                    "exchange": "CoinGecko",
                    "is_mock": ticker.is_mock if ticker else False,
                    "api_key_configured": bool(self.api_key),
                    "rate_limit": COINGECKO_RATE_LIMIT,
                }
            else:
                return {
                    "status": "OFFLINE",
                    "health_score": 0.0,
                    "version": COINGECKO_VERSION,
                    "last_check": datetime.now().isoformat(),
                    "message": "API connection failed",
                    "exchange": "CoinGecko",
                    "api_key_configured": bool(self.api_key),
                }
        except Exception as e:
            return {
                "status": "OFFLINE",
                "health_score": 0.0,
                "version": COINGECKO_VERSION,
                "last_check": datetime.now().isoformat(),
                "error": str(e),
                "exchange": "CoinGecko",
                "api_key_configured": bool(self.api_key),
            }
    
    def get_pairs(self) -> List[str]:
        return self.pairs.copy()
    
    def get_stats(self) -> Dict[str, Any]:
        return {
            "request_count": self._request_count,
            "cache_size": len(self._cache),
            "pairs_configured": len(self.pairs),
            "is_online": self._is_online,
            "api_base": self.api_base,
            "api_key_configured": bool(self.api_key),
            "rate_limit": COINGECKO_RATE_LIMIT,
        }
    
    def clear_cache(self) -> None:
        self._cache.clear()
        self._cache_time.clear()
        logger.debug("Cache cleared")
    
    def self_test(self) -> Dict[str, Any]:
        """Run self-test."""
        results = {
            "exchange": "CoinGecko",
            "version": COINGECKO_VERSION,
            "timestamp": datetime.now().isoformat(),
            "tests": {},
            "passed": 0,
            "failed": 0,
        }
        
        try:
            health = self.health_check()
            results["tests"]["health"] = health
            if health.get("status") == "ONLINE":
                results["passed"] += 1
            else:
                results["failed"] += 1
        except Exception as e:
            results["tests"]["health"] = {"error": str(e)}
            results["failed"] += 1
        
        try:
            ticker = self.get_ticker("BTC/USD")
            if ticker and ticker.price > 0:
                results["tests"]["ticker"] = {"status": "PASS", "price": ticker.price}
                results["passed"] += 1
            else:
                results["tests"]["ticker"] = {"status": "FAIL", "message": "No ticker data"}
                results["failed"] += 1
        except Exception as e:
            results["tests"]["ticker"] = {"status": "ERROR", "error": str(e)}
            results["failed"] += 1
        
        results["success"] = results["failed"] == 0
        return results


# ============================================================
# GLOBAL INSTANCE
# ============================================================

coingecko_market = CoinGeckoMarketData()
exchange = coingecko_market


# ============================================================
# CONVENIENCE FUNCTIONS
# ============================================================

def get_exchange() -> CoinGeckoMarketData:
    return coingecko_market

def get_market_data() -> CoinGeckoMarketData:
    return coingecko_market

def get_ticker(pair: str) -> Optional[TickerData]:
    return coingecko_market.get_ticker(pair)

def get_latest_prices(pairs: Optional[List[str]] = None) -> Dict[str, float]:
    return coingecko_market.get_latest_prices(pairs)

def get_ohlc(pair: str, interval: str = '1h', limit: int = 250) -> List[Candle]:
    return coingecko_market.get_ohlc(pair, interval, limit)

def test_connection() -> bool:
    return coingecko_market.health_check().get('status') == 'ONLINE'

def self_test() -> Dict[str, Any]:
    return coingecko_market.self_test()


# ============================================================
# EXPORTS (Maintain compatibility)
# ============================================================

# Alias for backward compatibility
KrakenMarketData = CoinGeckoMarketData
kraken_market = coingecko_market

__all__ = [
    "CoinGeckoMarketData",
